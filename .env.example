# .env.example

# PostgreSQL database config
POSTGRES_USER=git_validation_user
POSTGRES_PASSWORD=git_validation_password
POSTGRES_DB=git_validation
DB_HOST=db
DB_PORT=5432

# FastAPI settings
API_PORT=8000

# Python path inside Docker container
PYTHONPATH=/app

# JWT token params
SECRET_KEY=supersecretkey123
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Base URL for the API
API_BASE_URL=http://localhost:8000